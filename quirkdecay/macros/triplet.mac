/quirk/mass 500 GeV
/quirk/lambda 300 eV
/quirk/decayCtau 53.9087 mm
/quirk/decayDelta 167 MeV
/quirk/decayTable macros/triplet_dm167.txt
/qsim/card cards/cms_like.card
