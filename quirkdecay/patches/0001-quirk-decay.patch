diff --git a/quirkcore/src/QuirkDecay.cc b/quirkcore/src/QuirkDecay.cc
new file mode 100644
index 0000000..14c7481
--- /dev/null
+++ b/quirkcore/src/QuirkDecay.cc
@@ -0,0 +1,282 @@
+#include "quirkcore/QuirkDecay.h"
+#include <cstdio>
+#include <cstdlib>
+#include "G4VPhysicalVolume.hh"
+#include "G4StepPoint.hh"
+#include "quirkcore/Quirk.h"
+#include "quirkcore/QuirkStringStore.h"
+
+#include "G4DynamicParticle.hh"
+#include "G4Exception.hh"
+#include "G4ParticleTable.hh"
+#include "G4Step.hh"
+#include "G4Track.hh"
+#include "G4DecayProcessType.hh"
+#include "Randomize.hh"
+#include <CLHEP/Units/PhysicalConstants.h>
+
+#include <fstream>
+#include <sstream>
+
+QuirkDecayLog& QuirkDecayLog::instance() {
+  static thread_local QuirkDecayLog log;
+  return log;
+}
+
+namespace {
+  const G4ParticleDefinition* find(const G4String& name) {
+    const G4ParticleDefinition* d = G4ParticleTable::GetParticleTable()->FindParticle(name);
+    if (nullptr == d) {
+      G4Exception("QuirkDecay", "QuirkDecayUnknownParticle", FatalException, ("unknown particle " + name).c_str());
+    }
+    return d;
+  }
+  G4String conjugate(const G4String& name) {
+    const G4ParticleDefinition* d = find(name);
+    const G4ParticleDefinition* a = G4ParticleTable::GetParticleTable()->FindParticle(d->GetAntiPDGEncoding());
+    return (nullptr == a) ? name : a->GetParticleName();
+  }
+}  // namespace
+
+QuirkDecay::QuirkDecay(const QuirkConfig& cfg)
+    : G4VDiscreteProcess("QuirkDecay", fDecay), m_ctau(cfg.decayCtau), m_verbose(cfg.verbose), m_identity(cfg.decayIdentity) {
+  SetProcessSubType(DECAY);
+  if (!m_identity && !cfg.decayTable.empty())
+    loadTable(cfg.decayTable, cfg);
+  if (!m_identity && m_channels.empty()) {
+    G4Exception("QuirkDecay", "QuirkDecayNoChannels", FatalException,
+                "decay enabled but no channel table (/quirk/decayTable) and not in identity test mode");
+  }
+}
+
+QuirkDecay::~QuirkDecay() = default;
+
+void QuirkDecay::loadTable(const G4String& file, const QuirkConfig& cfg) {
+  std::ifstream in(file);
+  if (!in) {
+    G4Exception("QuirkDecay", "QuirkDecayTable", FatalException, ("cannot read decay table " + file).c_str());
+  }
+  for (std::string line; std::getline(in, line);) {
+    if (auto h = line.find('#'); h != std::string::npos)
+      line.erase(h);
+    std::istringstream ss(line);
+    double w;
+    if (!(ss >> w))
+      continue;
+    Channel ch;
+    ch.weight = w;
+    for (std::string n; ss >> n;)
+      ch.names.push_back(n);
+    if (ch.names.empty() || ch.names.size() > 2 || w <= 0.)
+      G4Exception("QuirkDecay", "QuirkDecayTable", FatalException, ("bad decay table line: " + line).c_str());
+    // charge conservation for the particle convention: the neutral partner carries no charge
+    double q = 0.;
+    for (auto& n : ch.names)
+      q += find(n)->GetPDGCharge();
+    if (std::abs(q - cfg.charge) > 1e-6 * CLHEP::eplus) {
+      G4Exception("QuirkDecay", "QuirkDecayCharge", FatalException,
+                  ("channel violates charge conservation (quirk charge " + std::to_string(cfg.charge / CLHEP::eplus) +
+                   "): " + line).c_str());
+    }
+    for (auto& n : ch.names) {
+      ch.prod[0].push_back(find(n));
+      ch.prod[1].push_back(find(conjugate(n)));
+    }
+    m_sumWeight += w;
+    m_channels.push_back(std::move(ch));
+  }
+}
+
+namespace {
+  // Kallen function of (M^2, M0^2, s) written with the exact mass difference D2 = M^2 - M0^2 (no cancellation)
+  inline G4double lambdaQ(G4double D2, G4double M0sq, G4double s) { return (D2 - s) * (D2 - s) - 4. * M0sq * s; }
+  inline G4double lambdaV(G4double s, G4double ma2, G4double mb2) {
+    return (s - ma2 - mb2) * (s - ma2 - mb2) - 4. * ma2 * mb2;
+  }
+  G4ThreeVector isotropic() {
+    const G4double c = 2. * G4UniformRand() - 1., ph = CLHEP::twopi * G4UniformRand(), s = std::sqrt(std::max(0., 1. - c * c));
+    return G4ThreeVector(s * std::cos(ph), s * std::sin(ph), c);
+  }
+}  // namespace
+
+namespace {
+  enum Kind { kConst, kLepton, kPiPi };
+  Kind kindOf(const G4ParticleDefinition* a, const G4ParticleDefinition* b) {
+    auto is = [](const G4ParticleDefinition* d, std::initializer_list<int> ids) {
+      for (int i : ids)
+        if (std::abs(d->GetPDGEncoding()) == i) return true;
+      return false;
+    };
+    if (b == nullptr) return kConst;
+    const bool nu = is(a, {12, 14, 16}) || is(b, {12, 14, 16});
+    if (nu) return kLepton;
+    if (is(a, {111, 211}) && is(b, {111, 211})) return kPiPi;
+    return kConst;
+  }
+}  // namespace
+
+// |M|^2 up to a constant, and in bound[0] an upper bound of it for the same channel
+G4double QuirkDecay::weight(G4double M, G4double M0, const G4ParticleDefinition* da, const G4ParticleDefinition* db,
+                            const G4LorentzVector& a, const G4LorentzVector& b, G4double bound[1]) {
+  const Kind k = kindOf(da, db);
+  const G4double Emax = (M - M0) + 0.5 * (M - M0) * (M - M0) / M;  // generous upper bound of any visible energy
+  const G4double E0 = M0;
+  const G4ThreeVector pq = -(a.vect() + b.vect());  // neutral quirk momentum
+  const G4double E0act = std::sqrt(pq.mag2() + M0 * M0);
+  if (k == kLepton) {
+    const G4double p0a = E0act * a.e() - pq.dot(a.vect());
+    const G4double p0b = E0act * b.e() - pq.dot(b.vect());
+    const G4double kk = a.e() * b.e() - a.vect().dot(b.vect());
+    bound[0] = 16. * M * Emax * Emax * (E0 + 2. * Emax);
+    return 8. * (p0a * M * b.e() + p0b * M * a.e() - M0 * M * kk);
+  }
+  if (k == kPiPi) {
+    const G4LorentzVector d = a - b;
+    const G4double P = E0act * M;  // p0.p+ in the parent rest frame
+    const G4double p0d = E0act * d.e() - pq.dot(d.vect());
+    bound[0] = 4. * (2. * M * Emax * (E0 * Emax + 4. * Emax * Emax) + 2. * Emax * Emax * (M - M0) * (M - M0)) * 1.5;
+    return 4. * (2. * p0d * M * d.e() - d.m2() * (P - M0 * M));
+  }
+  bound[0] = 1.;
+  return 1.;
+}
+
+void QuirkDecay::generate(G4double M, const G4ParticleDefinition* neutral, const std::vector<const G4ParticleDefinition*>& vis,
+                          std::vector<G4LorentzVector>& pvis, G4LorentzVector& pneutral) {
+  const G4double M0 = neutral->GetPDGMass();
+  const G4double D2 = (M - M0) * (M + M0), M0sq = M0 * M0;
+  pvis.clear();
+  const G4ThreeVector n = isotropic();
+  if (vis.size() == 1) {
+    const G4double ma = vis[0]->GetPDGMass();
+    const G4double lam = lambdaQ(D2, M0sq, ma * ma);
+    const G4double p = std::sqrt(std::max(lam, 0.)) / (2. * M);
+    pvis.emplace_back(p * n, std::sqrt(p * p + ma * ma));
+    pneutral = G4LorentzVector(-p * n, std::sqrt(p * p + M0sq));
+    return;
+  }
+  // three-body: invariant mass^2 s of the visible pair with density sqrt(lambdaQ) sqrt(lambdaV) / s
+  const G4double ma = vis[0]->GetPDGMass(), mb = vis[1]->GetPDGMass();
+  const G4double smin = (ma + mb) * (ma + mb), smax = (M - M0) * (M - M0);
+  auto f = [&](G4double s) {
+    const G4double lq = lambdaQ(D2, M0sq, s), lv = lambdaV(s, ma * ma, mb * mb);
+    return (lq > 0. && lv > 0.) ? std::sqrt(lq * lv) / s : 0.;
+  };
+  G4double fmax = 0.;
+  for (int i = 0; i <= 400; ++i)
+    fmax = std::max(fmax, f(smin + (smax - smin) * i / 400.));
+  fmax *= 1.05;
+  const G4double Mphys = M;
+  G4LorentzVector a, b;
+  G4double p = 0.;
+  for (int trial = 0; trial < 1000000; ++trial) {
+    G4double s = smin;
+    for (int t2 = 0; t2 < 100000; ++t2) {
+      s = smin + (smax - smin) * G4UniformRand();
+      if (fmax * G4UniformRand() < f(s))
+        break;
+    }
+    p = std::sqrt(std::max(lambdaQ(D2, M0sq, s), 0.)) / (2. * Mphys);  // recoil momentum of Q0
+    const G4double Eab = std::sqrt(s + p * p);
+    const G4double k = std::sqrt(std::max(lambdaV(s, ma * ma, mb * mb), 0.)) / (2. * std::sqrt(s));
+    const G4ThreeVector m = isotropic();
+    a = G4LorentzVector(k * m, std::sqrt(k * k + ma * ma));
+    b = G4LorentzVector(-k * m, std::sqrt(k * k + mb * mb));
+    const G4ThreeVector beta = (p / Eab) * n;
+    a.boost(beta);
+    b.boost(beta);
+    G4double bound[1];
+    const G4double w = weight(M, M0, vis[0], vis[1], a, b, bound);
+    if (w > bound[0]) {
+      G4Exception("QuirkDecay::generate", "QuirkDecayBound", JustWarning, "matrix-element bound exceeded");
+    }
+    if (G4UniformRand() * bound[0] < w)
+      break;
+  }
+  pvis = {a, b};
+  pneutral = G4LorentzVector(-(a.vect() + b.vect()), std::sqrt((a.vect() + b.vect()).mag2() + M0sq));
+}
+
+G4bool QuirkDecay::IsApplicable(const G4ParticleDefinition& p) {
+  return Quirk::isQuirk(&p) && p.GetPDGCharge() != 0.;
+}
+
+G4double QuirkDecay::GetMeanFreePath(const G4Track& track, G4double, G4ForceCondition* condition) {
+  *condition = NotForced;
+  if (m_ctau <= 0.)
+    return DBL_MAX;
+  const G4DynamicParticle* dp = track.GetDynamicParticle();
+  // lab decay length beta*gamma*c*tau; a quirk at rest (1 eV kept by keepStopped) still ages in proper time
+  const G4double bg = dp->GetTotalMomentum() / dp->GetMass();
+  return std::max(bg, 1e-12) * m_ctau;
+}
+
+G4VParticleChange* QuirkDecay::PostStepDoIt(const G4Track& track, const G4Step&) {
+  m_change.Initialize(track);
+  const G4DynamicParticle* dp = track.GetDynamicParticle();
+  const G4int pdg = track.GetDefinition()->GetPDGEncoding();
+  const G4int side = pdg > 0 ? 0 : 1;
+  const G4double mParent = dp->GetMass();
+  const G4ParticleDefinition* neutral = G4ParticleTable::GetParticleTable()->FindParticle(neutralPdg(pdg));
+
+  std::vector<const G4ParticleDefinition*> visDefs;
+  std::vector<G4LorentzVector> pvis;
+  G4LorentzVector pneutral;
+  const G4LorentzVector parent = dp->Get4Momentum();
+  if (m_identity) {
+    // test mode: the same quirk, relabelled as the neutral species, nothing else
+    pneutral = parent;
+  } else {
+    G4double u = G4UniformRand() * m_sumWeight, acc = 0.;
+    std::size_t k = 0;
+    for (; k + 1 < m_channels.size(); ++k) {
+      acc += m_channels[k].weight;
+      if (u < acc)
+        break;
+    }
+    visDefs = m_channels[k].prod[side];
+    generate(mParent, neutral, visDefs, pvis, pneutral);  // parent rest frame
+    const G4ThreeVector beta = parent.boostVector();
+    pneutral.boost(beta);
+    for (auto& p : pvis)
+      p.boost(beta);
+  }
+
+  QuirkDecayLog& log = QuirkDecayLog::instance();
+  QuirkDecayRecord rec;
+  rec.side = side;
+  rec.parentPdg = pdg;
+  rec.x = track.GetPosition();
+  rec.t = track.GetGlobalTime();
+  rec.parent = parent;
+  rec.daughter = pneutral;
+  const G4int recIndex = static_cast<G4int>(log.records.size());
+
+  m_change.SetNumberOfSecondaries(1 + static_cast<G4int>(pvis.size()));
+  G4LorentzVector sum = pneutral;
+  {
+    auto* d = new G4DynamicParticle(neutral, pneutral);
+    m_change.AddSecondary(new G4Track(d, track.GetGlobalTime(), track.GetPosition()));
+  }
+  for (std::size_t i = 0; i < pvis.size(); ++i) {
+    sum += pvis[i];
+    rec.products.push_back({visDefs[i]->GetPDGEncoding(), pvis[i]});
+    auto* t = new G4Track(new G4DynamicParticle(visDefs[i], pvis[i]), track.GetGlobalTime(), track.GetPosition());
+    t->SetUserInformation(new QuirkDecayProductInfo(recIndex, static_cast<G4int>(i)));
+    m_change.AddSecondary(t);
+  }
+  if (m_verbose > 0) {
+    const G4LorentzVector miss = sum - parent;
+    G4cout << "QuirkDecay: side " << side << " at " << track.GetPosition() / CLHEP::cm << " cm, t = "
+           << track.GetGlobalTime() / CLHEP::ns << " ns, " << rec.products.size() << " visible products, |dP| = "
+           << miss.vect().mag() / CLHEP::keV << " keV, |dE| = " << std::abs(miss.e()) / CLHEP::keV << " keV" << G4endl;
+  }
+  log.records.push_back(std::move(rec));
+
+  // the string stays: the neutral daughter continues it
+  QuirkStringStore::instance().stringFor(pdg).BeginHandover();
+
+  m_change.ProposeTrackStatus(fStopAndKill);
+  m_change.ProposeLocalEnergyDeposit(0.);
+  return &m_change;
+}
