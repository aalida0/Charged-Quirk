diff --git a/quirkcore/include/quirkcore/QuirkDecay.h b/quirkcore/include/quirkcore/QuirkDecay.h
new file mode 100644
index 0000000..c78f886
--- /dev/null
+++ b/quirkcore/include/quirkcore/QuirkDecay.h
@@ -0,0 +1,103 @@
+#ifndef QUIRKCORE_QuirkDecay_H
+#define QUIRKCORE_QuirkDecay_H
+
+// In-flight decay of the charged component of an SU(2)-multiplet quirk, Q -> Q0 + X, with the infracolor string
+// attached: the parent track ends, a track of the neutral partner Q0 (PDG |pdg|+1, mass m - Delta) starts at the same
+// point with the recoil momentum and inherits the string state through QuirkInfracolorForce::BeginHandover; the
+// visible products X are ordinary Geant4 secondaries.
+//
+// Lifetime: exponential in proper time, implemented as a G4VDiscreteProcess with mean free path beta*gamma*c*tau
+// (memoryless, so re-sampling when a suspended quirk resumes is statistically exact).
+// Kinematics: exact two- and three-body phase space generated in the parent rest frame with numerically stable
+// momenta (M - M0 << M; Geant4's generic G4PhaseSpaceDecayChannel fails on such decays), weighted by the squared
+// matrix element of the vector-like heavy current coupled to the W* (spin-averaged heavy-fermion tensor
+// H_mn = Tr[(p0+M0) g_m (p+ + M) g_n] contracted with the lepton tensor k_a^m k_b^n + k_a^n k_b^m - g^mn k_a.k_b for
+// l nu, with (k1-k2)^m (k1-k2)^n for pi pi0, constant for a single pion). The heavy neutral quirk recoils, so energy
+// and momentum are conserved exactly. At most two visible products per channel.
+//
+// Channel file (/quirk/decayTable), one channel per line, '#' comments:
+//     <weight> <daughter name> [<daughter name> ...]
+// written for the particle with positive PDG code (charge = /quirk/charge); the antiquirk decays to the conjugate
+// channels. The neutral quirk is added automatically. Example for charge -1:
+//     0.82  pi-
+//     0.10  e-  anti_nu_e
+//     0.08  mu- anti_nu_mu
+
+#include "quirkcore/QuirkConfig.h"
+
+#include "G4VDiscreteProcess.hh"
+#include "G4ParticleChange.hh"
+#include "G4VUserTrackInformation.hh"
+#include "G4LorentzVector.hh"
+#include "G4ThreeVector.hh"
+
+#include <memory>
+#include <vector>
+
+class G4ParticleDefinition;
+
+// truth record of one decay, per thread and event (filled by QuirkDecay, read by the user actions)
+struct QuirkDecayRecord {
+  struct Product {
+    G4int pdg;
+    G4LorentzVector p;
+  };
+  G4int side{0};  // 0: quirk (PDG > 0), 1: antiquirk
+  G4int parentPdg{0};
+  G4ThreeVector x;
+  G4double t{0};
+  G4LorentzVector parent, daughter;
+  std::vector<Product> products;
+};
+
+class QuirkDecayLog {
+public:
+  static QuirkDecayLog& instance();
+  std::vector<QuirkDecayRecord> records;
+  void clear() { records.clear(); }
+};
+
+// attached to the visible decay products so that the user actions can record their hits
+class QuirkDecayProductInfo : public G4VUserTrackInformation {
+public:
+  QuirkDecayProductInfo(G4int record, G4int index) : record(record), index(index) {}
+  G4int record, index;
+};
+
+class QuirkDecay : public G4VDiscreteProcess {
+public:
+  explicit QuirkDecay(const QuirkConfig& cfg);
+  ~QuirkDecay() override;
+
+  G4bool IsApplicable(const G4ParticleDefinition& p) override;
+  G4VParticleChange* PostStepDoIt(const G4Track& track, const G4Step& step) override;
+
+  // pdg of the neutral partner of the quirk with PDG code pdg
+  static G4int neutralPdg(G4int pdg) { return pdg > 0 ? pdg + 1 : pdg - 1; }
+
+protected:
+  G4double GetMeanFreePath(const G4Track& track, G4double previousStepSize, G4ForceCondition* condition) override;
+
+private:
+  struct Channel {
+    G4double weight;
+    std::vector<G4String> names;                       // products, particle convention
+    std::vector<const G4ParticleDefinition*> prod[2];  // [0] quirk, [1] antiquirk (conjugates)
+  };
+  void loadTable(const G4String& file, const QuirkConfig& cfg);
+  // products (pdg, 4-momentum) in the parent rest frame plus the neutral quirk's 4-momentum
+  static void generate(G4double M, const G4ParticleDefinition* neutral, const std::vector<const G4ParticleDefinition*>& vis,
+                       std::vector<G4LorentzVector>& pvis, G4LorentzVector& pneutral);
+  // squared matrix element (up to a constant) of a configuration in the parent rest frame
+  static G4double weight(G4double M, G4double M0, const G4ParticleDefinition* da, const G4ParticleDefinition* db,
+                         const G4LorentzVector& a, const G4LorentzVector& b, G4double bound[1]);
+
+  G4ParticleChange m_change;
+  G4double m_ctau;
+  G4int m_verbose;
+  G4bool m_identity;
+  std::vector<Channel> m_channels;
+  G4double m_sumWeight{0.};
+};
+
+#endif
