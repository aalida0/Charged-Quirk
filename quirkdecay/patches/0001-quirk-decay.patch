+// hits of the visible decay products (one per continuous visit of a sensitive volume), tagged
+// h_q = 100 * (decay record + 1) + product index
+void SteppingAction::productStep(const G4Step* step, const QuirkDecayProductInfo* info) {
+  const G4Track* t = step->GetTrack();
+  if (t->GetParticleDefinition()->GetPDGCharge() == 0.)
+    return;
+  const GeomInfo& g = geomInfo();
+  const G4StepPoint* pre = step->GetPreStepPoint();
+  const G4StepPoint* post = step->GetPostStepPoint();
+  const G4int vol = pre->GetPhysicalVolume()->GetCopyNo();
+  const G4int tid = t->GetTrackID();
+  auto it = m_ev->productHit.find(tid);
+  if (!g.vols[vol].sens) {
+    if (it != m_ev->productHit.end())
+      m_ev->productHit.erase(it);
+    return;
+  }
+  if (it == m_ev->productHit.end() || it->second.second != vol) {
+    EventAction::Hit h;
+    h.q = 100 * (info->record + 1) + info->index;
+    h.vol = vol;
+    h.x0 = pre->GetPosition();
+    h.t0 = pre->GetGlobalTime();
+    h.p = pre->GetMomentum();
+    m_ev->hits.push_back(h);
+    it = m_ev->productHit.insert_or_assign(tid, std::make_pair(G4int(m_ev->hits.size() - 1), vol)).first;
+  }
+  EventAction::Hit& h = m_ev->hits[it->second.first];
+  ++h.nsteps;
+  h.dE += step->GetTotalEnergyDeposit();
+  h.len += step->GetStepLength();
+  h.x1 = post->GetPosition();
+  h.t1 = post->GetGlobalTime();
+  if (post->GetPhysicalVolume() != pre->GetPhysicalVolume() || t->GetTrackStatus() == fStopAndKill)
+    m_ev->productHit.erase(it);
+}
